{
  "name": "@sutyr/webhook-lab",
  "version": "0.2.0",
  "description": "A test suite for your Stripe webhook handler: signature, replay, duplicate, ordering and timing checks, plus schema-accurate signed Stripe events for your own tests.",
  "packageManager": "pnpm@10.30.3",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Sutyr Inc. <legal@sutyr.com> (https://sutyr.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sutyr/webhook-lab.git"
  },
  "bugs": {
    "url": "https://github.com/sutyr/webhook-lab/issues"
  },
  "homepage": "https://lab.sutyr.com",
  "type": "module",
  "keywords": [
    "stripe",
    "stripe-webhooks",
    "webhook",
    "webhook-testing",
    "test-suite",
    "conformance",
    "stripe-signature",
    "signature-verification",
    "idempotency",
    "testing",
    "ci",
    "cli",
    "events",
    "billing",
    "payment",
    "mock",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "webhook-lab": "./dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test && vitest run --config vitest.integration.config.ts",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:events": "pnpm --filter @webhook-lab/events test",
    "test:signatures": "pnpm --filter @webhook-lab/signatures test",
    "test:conformance": "pnpm --filter @webhook-lab/conformance test",
    "build": "pnpm -r build",
    "build:pkg": "tsup"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "stripe": "^22.1.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.9"
  }
}
